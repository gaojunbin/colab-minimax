# ============================================================================
# Colab MiniMax H3 (ComfyUI) Auto-Lifecycle Gateway Configuration
# ============================================================================

# Port exposed on host
PORT=8188

# Web UI Login Credentials
WEB_USERNAME=admin
WEB_PASSWORD=admin123

# API Key for programmatic access (Header: X-API-Key or Authorization: Bearer <KEY>)
API_KEY=sk-minimax-h3-colab-key

# Secret key for signing Web Session Cookies
SECRET_KEY=minimax-h3-colab-super-secret-session-key-2026

# Colab Runtime Settings
COLAB_SESSION_NAME=minimax-h3
COLAB_AUTH_MODE=oauth2
# Default GPU type: L4, A100, H100, T4, G4
DEFAULT_GPU=L4
# Fallback GPU order if requested GPU is unavailable (comma-separated)
FALLBACK_GPUS=L4,A100,T4

# Lifecycle & Auto-Shutdown Settings
# Idle timeout in seconds before saving outputs and releasing Colab GPU (1800 = 30 minutes)
IDLE_TIMEOUT_SECONDS=1800

# Google Drive Persistence Settings
ENABLE_DRIVE_MOUNT=true
DRIVE_BASE_DIR=/content/drive/MyDrive/Colab-MiniMax-H3
# Skip heavy ComfyUI-Manager installation on boot to save ~18s startup time
INSTALL_COMFYUI_MANAGER=false
# Prewarm models from Google Drive into Linux RAM cache in background after ComfyUI is ready
PREWARM_DRIVE_MODELS=true

# Model Download Settings (Comfy-Org/MiniMax-H3 & Momoking Heretic NVFP4)
HF_REPO_ID=Comfy-Org/MiniMax-H3
HERETIC_REPO_ID=Momoking/Qwen3-VL-32B-Heretic-MiniMax-H3-NVFP4
UNET_MODEL=minimax_h3_fl2va_pruned_int8_convrot.safetensors
CLIP_MODEL=qwen3vl_32b_heretic_minimax_h3_nvfp4.safetensors
OFFICIAL_CLIP_MODEL=qwen3vl_32b_minimax_h3_nvfp4_awq.safetensors
HERETIC_CLIP_MODEL=qwen3vl_32b_heretic_minimax_h3_nvfp4.safetensors
VIDEO_VAE_MODEL=minimax_h3_video_vae_int8_convrot.safetensors
AUDIO_VAE_MODEL=minimax_h3_audio_vae_fp32.safetensors
TURBO_LORA_8STEP=minimax_h3_fl2v_turbo_8step_v1.0_comfyui_bf16.safetensors
TURBO_LORA_4STEP=minimax_h3_fl2v_turbo_4step_v1.0_768p_comfyui_bf16.safetensors
